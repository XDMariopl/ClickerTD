@startuml
title ClickerTD Klašu Diagramma - Pārskats

skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam ranksep 70
skinparam nodesep 55
skinparam ArrowThickness 1
skinparam ArrowColor #444444

left to right direction

package "Progresija" {
  class ProgressManager
  class LevelManager
  class PlayerProgressData
  class LevelMedalProgress
  class LevelEntry
  enum LevelPlayMode
}

package "Kauja Un Raundi" {
  class RoundManager
  class RoundEntry
  class EnemySpawner
  class EndlessModeConfig
  class EndlessEnemyOption
  class EndlessEnemyModifierOption
  class EnemyEntry
}

package "Pretinieki" {
  class EnemyHealth
  class EnemyMover
  class EnemyManager
  class DmgClick
  enum EnemyModifierType
  enum EnemyDamageSource
}

package "Torņi" {
  class TowerData
  class TowerLevel
  class TowerBuff
  class TowerPlace
  class TowerSelectable
  class TowerSelectButton
  class TowerUpgradeUI
  interface IHitEffect
  class NthHitDamageEffect
  class ChainHitDamage
  class BombHitDamage
  class SlowHitEffect
  class MoneyHitEffect
  class ReverseHitEffect
  enum TowerEffectType
}

package "Ievade Un Saskarne" {
  class PlayerCursor
  class ClickManager
  class HitContext
  class MoneySystem
  class PlayerHealth
  class WinLoseUI
  class ScenePauseManager
  class SceneController
}

package "Karte Un Režģis" {
  class GridManager
  class Path
  class ObstaclePath
  class LevelInitializer
}

ProgressManager *-down- PlayerProgressData
PlayerProgressData *-down- LevelMedalProgress
LevelManager *-down- LevelEntry
LevelManager --> LevelPlayMode

RoundManager *-down- RoundEntry
RoundManager --> EnemySpawner
RoundManager --> EndlessModeConfig
EndlessModeConfig *-down- EndlessEnemyOption
EndlessModeConfig *-down- EndlessEnemyModifierOption
EnemySpawner *-down- EnemyEntry

TowerBuff *-down- TowerLevel
TowerLevel --> TowerEffectType
TowerPlace --> TowerData
TowerPlace --> GridManager
TowerSelectable --> TowerBuff
TowerSelectButton --> TowerData
TowerSelectButton --> TowerPlace
TowerUpgradeUI --> TowerBuff

IHitEffect <|.. NthHitDamageEffect
IHitEffect <|.. ChainHitDamage
IHitEffect <|.. BombHitDamage
IHitEffect <|.. SlowHitEffect
IHitEffect <|.. MoneyHitEffect
IHitEffect <|.. ReverseHitEffect

PlayerCursor --> IHitEffect
PlayerCursor --> HitContext
HitContext --> EnemyHealth
HitContext --> EnemyDamageSource

EnemySpawner --> EnemyMover
EnemySpawner --> EnemyHealth
EnemySpawner --> Path
EnemyHealth --> EnemyModifierType
EnemyHealth --> EnemyDamageSource
EnemyHealth --> MoneySystem
EnemyHealth --> EnemyManager
EnemyMover --> Path

LevelManager --> ProgressManager
LevelManager --> SceneController
ProgressManager --> TowerData
RoundManager --> ProgressManager
RoundManager --> LevelManager
RoundManager --> WinLoseUI
PlayerHealth --> RoundManager
PlayerHealth --> WinLoseUI
WinLoseUI --> ScenePauseManager
SceneController --> ScenePauseManager

LevelInitializer --> GridManager
LevelInitializer --> Path
LevelInitializer --> ObstaclePath

note bottom of ProgressManager
Skaties detalizētās diagrammas:
- UML_Project_Progression.puml
- UML_Project_Combat.puml
- UML_Project_Towers.puml
- UML_Project_MapUI.puml
end note

@enduml
